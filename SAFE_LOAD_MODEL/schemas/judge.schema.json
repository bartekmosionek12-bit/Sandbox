{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JudgeVerdict",
  "description": "Wynik warstwy 3: werdykt sędziego LLM na podstawie kontraktów parsera i sandboksa.",
  "type": "object",
  "required": ["schema_version", "available", "verdict", "reasoning"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "available": {
      "type": "boolean",
      "description": "false = sędzia niedostępny (np. brak ANTHROPIC_API_KEY). Wtedy verdict='unknown'."
    },
    "verdict": {
      "type": "string",
      "enum": ["malicious", "suspicious", "safe", "unknown"]
    },
    "confidence": {
      "type": ["string", "null"],
      "enum": ["high", "medium", "low", null]
    },
    "reasoning": { "type": "string", "description": "2-3 zdania uzasadnienia." },
    "model": { "type": ["string", "null"] },
    "error": { "type": ["string", "null"] }
  }
}
