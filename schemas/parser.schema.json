{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "StaticParserReport",
  "description": "Wynik warstwy 1: statyczna analiza pliku. Dashboard i sędzia czytają tylko ten kontrakt, nie znają formatu pliku.",
  "type": "object",
  "required": ["schema_version", "file_name", "file_format", "flagged_opcodes", "suspicious_imports", "raw_disasm", "static_risk"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "file_name": { "type": "string" },
    "file_format": { "type": "string", "enum": ["pickle", "unknown"] },
    "opcodes": {
      "type": "array",
      "description": "Wszystkie opcody w kolejności występowania.",
      "items": {
        "type": "object",
        "required": ["name", "pos"],
        "properties": {
          "name": { "type": "string" },
          "arg": { "type": ["string", "null"] },
          "pos": { "type": "integer" }
        }
      }
    },
    "flagged_opcodes": {
      "type": "array",
      "description": "Opcody uznane za niebezpieczne (GLOBAL, REDUCE, STACK_GLOBAL, INST, OBJ, NEWOBJ...).",
      "items": {
        "type": "object",
        "required": ["name", "pos"],
        "properties": {
          "name": { "type": "string" },
          "arg": { "type": ["string", "null"] },
          "pos": { "type": "integer" },
          "reason": { "type": "string" }
        }
      }
    },
    "suspicious_imports": {
      "type": "array",
      "description": "Importy wykryte przez GLOBAL/STACK_GLOBAL, które pasują do listy niebezpiecznych modułów/symboli.",
      "items": {
        "type": "object",
        "required": ["module", "symbol"],
        "properties": {
          "module": { "type": "string" },
          "symbol": { "type": "string" },
          "pos": { "type": ["integer", "null"] }
        }
      }
    },
    "raw_disasm": { "type": "string", "description": "Surowy output pickletools.dis() do pokazania na dashboardzie." },
    "static_risk": {
      "type": "string",
      "enum": ["malicious", "suspicious", "clean"],
      "description": "Heurystyczna ocena statyczna. NIE jest werdyktem końcowym — sędzia LLM decyduje."
    },
    "notes": { "type": "array", "items": { "type": "string" } },
    "error": { "type": ["string", "null"] }
  }
}
